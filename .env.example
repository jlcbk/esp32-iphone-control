# ESP32-S3 USB CDC serial port (auto-discovered from /dev/cu.usbmodem* when unset)
# ESP32_SERIAL_PORT=/dev/cu.usbmodemXXXXXXXXXXXX

# Local Ollama chat API endpoint and vision model for Tier 3 grounded GUI agent (iphone_agent.py)
OLLAMA_API_URL=http://127.0.0.1:11434/api/chat
OLLAMA_MODEL=qwen3.5:4b

# Local HTTP clipboard mailbox server for fast AgentPaste + Cmd+V input (clipboard_http.py)
IPHONE_CLIP_PORT=8766
# Paste trigger: btn:2..btn:5 (AssistiveTouch mouse button), key:ctrl+alt+v (keyboard shortcut), or pbcopy (Universal Clipboard)
IPHONE_PASTE_TRIGGER=btn:3
# Optional Stage 1/2 overrides:
# IPHONE_FORCE_REL=1
# IPHONE_ALWAYS_PASTE=1
# IPHONE_PBCOPY_FALLBACK=1
# IPHONE_PBCOPY_WAIT=2.0
